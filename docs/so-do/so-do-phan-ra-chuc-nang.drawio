        <mxCell id="group_data" value="&lt;b&gt;1. Mô hình &amp;amp; Lưu trữ Dữ liệu&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
