        <!-- Nhóm 2 -->
        <mxCell id="group_core" value="&lt;b&gt;2. Nghiệp vụ Điểm danh &amp;amp; Đồng thời&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
