        <!-- Tiêu đề sơ đồ -->
        <mxCell id="title" value="&lt;b&gt;SƠ ĐỒ KIẾN TRÚC CÁC TẦNG HỆ THỐNG (LAYER STACK ARCHITECTURE)&lt;/b&gt;&lt;br&gt;Tuân thủ nguyên tắc: Tầng Nghiệp vụ hoàn toàn độc lập với Tầng Mạng &amp;amp; Giao diện" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#343a40;fontColor=#212529;fontSize=14;fontStyle=1;" vertex="1" parent="1">
