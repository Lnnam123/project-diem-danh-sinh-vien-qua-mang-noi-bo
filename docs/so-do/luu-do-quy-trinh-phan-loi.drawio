        <!-- Tiêu đề -->
        <mxCell id="title_flow" value="&lt;b&gt;LƯU ĐỒ QUY TRÌNH XỬ LÝ ĐIỂM DANH PHẦN LÕI (CORE CHECK-IN FLOWCHART)&lt;/b&gt;&lt;br&gt;Xác thực cú pháp, kiểm tra thời hạn phiên, chống trùng mã sinh viên &amp;amp; chống gửi hộ qua IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#343a40;fontColor=#212529;fontSize=13;fontStyle=1;" vertex="1" parent="1">
